rules_version = '2';

// Security rules for PantryMatch.
// Principle: no unrestricted public access. Each user manages only their
// own data; public recipes are readable by authenticated users.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profile and its sub-collections (pantry, friends, favorites):
    // accessible only to the owner.
    match /users/{uid} {
      allow read: if isSignedIn();          // profiles are readable (e.g. authors/friends)
      allow write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Recipes: readable if public or if you are the author; writable only by the author.
    match /recipes/{recipeId} {
      allow read: if isSignedIn() &&
                     (resource.data.isPublic == true ||
                      resource.data.authorId == request.auth.uid);
      allow create: if isSignedIn() &&
                       request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
                               resource.data.authorId == request.auth.uid;
    }
  }
}
