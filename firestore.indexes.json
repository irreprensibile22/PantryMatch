{
  "indexes": [
    {
      "//": "getMyRecipes(): the author's recipes sorted by date, newest first.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "authorId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "searchByPantry(): public recipes pre-filtered by ingredient.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic", "order": "ASCENDING" },
        { "fieldPath": "ingredientNames", "arrayConfig": "CONTAINS" }
      ]
    }
  ],
  "fieldOverrides": []
}
