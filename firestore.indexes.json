{
  "indexes": [
    {
      "//": "getMyRecipes(): ricette dell'autore ordinate per data decrescente.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "authorId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "searchByPantry(): ricette pubbliche pre-filtrate per ingrediente.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic", "order": "ASCENDING" },
        { "fieldPath": "ingredientNames", "arrayConfig": "CONTAINS" }
      ]
    }
  ],
  "fieldOverrides": []
}
