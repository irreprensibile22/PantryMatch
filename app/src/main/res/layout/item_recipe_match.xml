<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="18dp"
    app:cardBackgroundColor="@color/tavola_card"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/tavola_hairline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageRecipe"
                android:layout_width="match_parent"
                android:layout_height="184dp"
                android:background="#EBDFCF"
                android:contentDescription="@string/recipe_image"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/textBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="13dp"
                android:paddingHorizontal="11dp"
                android:paddingVertical="5dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:background="@drawable/bg_badge_ready"
                tools:text="Preparabile" />

            <ImageButton
                android:id="@+id/buttonFavorite"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_gravity="top|end"
                android:layout_margin="13dp"
                android:background="@drawable/bg_favorite_scrim"
                android:contentDescription="@string/detail_favorite_add"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/tavola_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="13dp"
            android:paddingBottom="15dp">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:letterSpacing="-0.005"
                android:maxLines="2"
                android:textColor="@color/tavola_ink"
                android:textSize="18.5sp"
                android:textStyle="bold"
                tools:text="Pancakes della domenica" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textAvatar"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="P" />

                <TextView
                    android:id="@+id/textAuthor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tavola_muted"
                    android:textSize="13sp"
                    tools:text="di pietro" />

                <TextView
                    android:id="@+id/textTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:drawablePadding="5dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/tavola_muted"
                    android:textSize="12.5sp"
                    app:drawableStartCompat="@drawable/ic_clock"
                    tools:text="15 min" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
