<?xml version="1.0" encoding="utf-8"?>
<!-- Dettaglio ricetta: foto hero, meta a pillole, ingredienti e procedimento. -->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tavola_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageRecipe"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="@color/tavola_tile"
            android:contentDescription="@string/recipe_image"
            android:scaleType="centerCrop" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="-0.01"
                android:textColor="@color/tavola_ink"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/tavola_muted"
                android:textSize="13.5sp" />

            <LinearLayout
                android:id="@+id/rowMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textCategory"
                    style="@style/TavolaMetaPill"
                    android:visibility="gone"
                    tools:text="Primo" />

                <TextView
                    android:id="@+id/textPrepTime"
                    style="@style/TavolaMetaPill"
                    android:layout_marginStart="8dp"
                    android:drawablePadding="5dp"
                    app:drawableStartCompat="@drawable/ic_clock"
                    android:drawableTint="@color/tavola_muted_dark"
                    android:visibility="gone"
                    tools:text="30 min" />

                <TextView
                    android:id="@+id/textDifficulty"
                    style="@style/TavolaMetaPill"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    tools:text="Facile" />
            </LinearLayout>

            <TextView
                android:id="@+id/textDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/tavola_muted_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="serif"
                android:text="@string/ingredients"
                android:textColor="@color/tavola_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TavolaEditorCard">

                <TextView
                    android:id="@+id/textIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:textColor="@color/tavola_muted_dark"
                    android:textSize="15sp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="serif"
                android:text="@string/steps"
                android:textColor="@color/tavola_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TavolaEditorCard">

                <TextView
                    android:id="@+id/textSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp"
                    android:padding="16dp"
                    android:textColor="@color/tavola_muted_dark"
                    android:textSize="15sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
