<?xml version="1.0" encoding="utf-8"?>
<!-- Profile: user hero, stats, Account/Preferences sections and logout. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tavola_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tavola_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="32dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/textAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_avatar_hero"
                android:fontFamily="serif"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold"
                tools:text="A" />

            <TextView
                android:id="@+id/textName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:letterSpacing="-0.01"
                android:textColor="@color/tavola_ink"
                android:textSize="27sp"
                android:textStyle="bold"
                tools:text="admin" />

            <TextView
                android:id="@+id/textEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/tavola_muted"
                android:textSize="13.5sp"
                tools:text="admin@admin.com" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/TavolaStatCard"
                    android:layout_marginEnd="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="15dp">

                        <TextView
                            android:id="@+id/textStatRecipes"
                            style="@style/TavolaStatNumber"
                            tools:text="3" />

                        <TextView
                            style="@style/TavolaStatLabel"
                            android:text="@string/profile_stat_recipes" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/TavolaStatCard"
                    android:layout_marginEnd="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="15dp">

                        <TextView
                            android:id="@+id/textStatSaved"
                            style="@style/TavolaStatNumber"
                            tools:text="12" />

                        <TextView
                            style="@style/TavolaStatLabel"
                            android:text="@string/profile_stat_saved" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/TavolaStatCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="15dp">

                        <TextView
                            android:id="@+id/textStatFriends"
                            style="@style/TavolaStatNumber"
                            tools:text="3" />

                        <TextView
                            style="@style/TavolaStatLabel"
                            android:text="@string/profile_stat_friends" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                style="@style/TavolaSectionLabel"
                android:layout_marginTop="24dp"
                android:text="@string/profile_account" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TavolaListCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        layout="@layout/item_account_row"
                        android:id="@+id/rowEditName" />

                    <View style="@style/TavolaRowDivider" />

                    <include
                        layout="@layout/item_account_row"
                        android:id="@+id/rowChangeEmail" />

                    <View style="@style/TavolaRowDivider" />

                    <include
                        layout="@layout/item_account_row"
                        android:id="@+id/rowChangePassword" />

                    <View style="@style/TavolaRowDivider" />

                    <include
                        layout="@layout/item_account_row"
                        android:id="@+id/rowResetPassword" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TavolaSectionLabel"
                android:layout_marginTop="24dp"
                android:text="@string/profile_preferences" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TavolaListCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_tile_accent"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/tavola_accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_notifications"
                        android:textColor="@color/tavola_ink"
                        android:textSize="15sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLogout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/logout"
                app:cornerRadius="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/profile_version"
                android:textColor="@color/tavola_label"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
