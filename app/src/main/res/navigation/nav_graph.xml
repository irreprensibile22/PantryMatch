<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/searchFragment">

    <!-- Grafo di navigazione unico: start = Home (searchFragment); login/registrazione svuotano il back stack. -->

    <fragment
        android:id="@+id/pantryFragment"
        android:name="com.example.esamemobile.ui.pantry.PantryFragment"
        android:label="@string/nav_pantry"
        tools:layout="@layout/fragment_pantry" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.esamemobile.ui.search.SearchFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_search_to_detail"
            app:destination="@id/recipeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/friendsFragment"
        android:name="com.example.esamemobile.ui.friends.FriendsFragment"
        android:label="@string/nav_friends"
        tools:layout="@layout/fragment_friends">
        <action
            android:id="@+id/action_friends_to_friend_recipes"
            app:destination="@id/friendRecipesFragment" />
    </fragment>

    <fragment
        android:id="@+id/friendRecipesFragment"
        android:name="com.example.esamemobile.ui.friends.FriendRecipesFragment"
        android:label="@string/nav_friend_recipes"
        tools:layout="@layout/fragment_friend_recipes">
        <argument
            android:name="authorId"
            app:argType="string" />
        <argument
            android:name="authorName"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_friend_recipes_to_detail"
            app:destination="@id/recipeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.esamemobile.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/recipeBookFragment"
        android:name="com.example.esamemobile.ui.recipebook.RecipeBookFragment"
        android:label="@string/nav_recipe_book"
        tools:layout="@layout/fragment_recipebook">
        <action
            android:id="@+id/action_recipebook_to_detail"
            app:destination="@id/recipeDetailFragment" />
        <action
            android:id="@+id/action_recipebook_to_edit"
            app:destination="@id/recipeEditFragment" />
        <action
            android:id="@+id/action_recipebook_to_recipes_grid"
            app:destination="@id/recipesGridFragment" />
    </fragment>

    <fragment
        android:id="@+id/recipesGridFragment"
        android:name="com.example.esamemobile.ui.profile.RecipesGridFragment"
        android:label="@string/profile_my_recipes"
        tools:layout="@layout/fragment_recipes_grid">
        <argument
            android:name="mode"
            app:argType="string"
            android:defaultValue="mine" />
        <action
            android:id="@+id/action_recipes_grid_to_detail"
            app:destination="@id/recipeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/recipeDetailFragment"
        android:name="com.example.esamemobile.ui.recipe.RecipeDetailFragment"
        android:label="@string/nav_recipe"
        tools:layout="@layout/fragment_recipe_detail">
        <argument
            android:name="recipeId"
            app:argType="string" />
        <action
            android:id="@+id/action_detail_to_edit"
            app:destination="@id/recipeEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/recipeEditFragment"
        android:name="com.example.esamemobile.ui.recipe.RecipeEditFragment"
        android:label="@string/nav_recipe_edit"
        tools:layout="@layout/fragment_recipe_edit">
        <argument
            android:name="recipeId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.esamemobile.ui.auth.LoginFragment"
        android:label="@string/login"
        tools:layout="@layout/fragment_login">
        <!-- dopo il login vado alla Home rimuovendo il login dal back stack (niente ritorno con back) -->
        <action
            android:id="@+id/action_login_to_pantry"
            app:destination="@id/searchFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.esamemobile.ui.auth.RegisterFragment"
        android:label="@string/register_title"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_pantry"
            app:destination="@id/searchFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
